---
import { classTimes, faculties, type Program } from '../../data/programs';
interface Props { program: Program; index: number }
const { program, index } = Astro.props;
// The costs page may ignore this selection until the calculator migration.
const costUrl = `/biaya-beasiswa?${new URLSearchParams({ program: program.slug })}`;
---
<article class="program-row" data-program-id={program.id} data-program-name={program.name}
  data-program-faculty={program.facultyId} aria-labelledby={`program-${program.id}`}>
  <details>
    <summary>
      <h3 class="program-summary" aria-labelledby={`program-${program.id}`}>
        <span class="program-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span class="program-identity">
          <span class="program-title" id={`program-${program.id}`}>{program.name}</span>
          <span class="program-faculty">{faculties[program.facultyId]}</span>
        </span>
        <span class="program-times">{program.classes.map((time) => <span>{classTimes[time]}</span>)}</span>
        <span class="program-toggle" aria-hidden="true">
          <span class="program-toggle-closed">Detail</span><span class="program-toggle-open">Tutup</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" /></svg>
        </span>
      </h3>
    </summary>
    <div class="program-detail">
      <div class="program-overview">
        <p class="meta-label">Kenali bidangnya</p>
        <p class="program-description">{program.description}</p>
        <dl class="program-facts">
          <div><dt>Pilihan waktu kuliah</dt><dd>{program.classes.map((time) => classTimes[time]).join(' · ')}</dd></div>
          {program.accreditation && <div><dt>Akreditasi program</dt><dd>{program.accreditation.label}</dd></div>}
        </dl>
      </div>
      <div class="program-cost-action">
        <p class="meta-label">Langkah selanjutnya</p>
        <p class="program-cost-prompt">Pertimbangkan pilihanmu.<br /> Siapkan rencana biayanya.</p>
        <a class="program-cost-link" href={costUrl} aria-describedby={`cost-note-${program.id}`}>
          <span>Lihat biaya untuk {program.name}</span><span aria-hidden="true">↗</span>
        </a>
        <p class="program-cost-note" id={`cost-note-${program.id}`}>Program ini akan terpilih pada simulator biaya.</p>
      </div>
    </div>
  </details>
</article>
