---
import DegreeSelector from '../components/DegreeSelector.astro';
import GraduateContent from '../components/GraduateContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import TuitionCalculator from '../components/TuitionCalculator.astro';
import { registration, september2026 } from '../data/admissions';
import { margondaPrograms } from '../data/programs';
import { tuition } from '../data/tuition';
import { scholarships } from '../data/scholarships';
import { calculateTuition } from '../utils/tuition';
import { formatRupiah } from '../utils/currency';
import '../styles/tuition.css';

const tuitionRateMap = new Map<number, string[]>();
for (const program of margondaPrograms.programs) {
  const amount = calculateTuition({ programId: program.id, waveId: september2026.waves[0].id })!.semesterTuition;
  tuitionRateMap.set(amount, [...(tuitionRateMap.get(amount) ?? []), program.name]);
}
const tuitionRateGroups = [...tuitionRateMap.entries()].sort(([left], [right]) => right - left);
---
<BaseLayout title="Biaya & Beasiswa" description="Rencanakan biaya S1 dan S2 UBSI Margonda: simulator S1 dan perbandingan struktur pembayaran pascasarjana.">
  <div class="academic-route">
  <DegreeSelector />
  <div data-degree-panel="S1" id="sarjana">
  <header class="tuition-intro container">
    <p class="eyebrow">Biaya &amp; Beasiswa · S1 Margonda</p>
    <h1>Kenali biayanya.<br /><span>Rencanakan langkahmu.</span></h1>
    <p class="lead">Financial Cost Simulator membantu kamu memahami biaya kuliah, satu komponen dalam satu waktu. Untuk {september2026.label}.</p>
  </header>
  <div class="container tuition-main"><TuitionCalculator /></div>
  <section class="page-section tuition-components" aria-labelledby="components-title">
    <div class="container">
      <p class="meta-label">Pahami rinciannya</p>
      <h2 id="components-title">Apa saja yang dihitung?</h2>
      <dl class="tuition-definitions tuition-definitions-desktop">
        <div><dt>Pendaftaran</dt><dd>{formatRupiah(tuition.registration)} untuk proses pendaftaran PMB.</dd></div>
        <div><dt>Prakuliah</dt><dd>Komponen biaya prakuliah S1 sebesar {formatRupiah(tuition.preCollege)}.</dd></div>
        <div><dt>Kuliah per semester</dt><dd>Tarif dasar {formatRupiah(tuition.baseSemester)}; tambahan {formatRupiah(tuition.semesterSurcharge)} hanya untuk enam program yang ditetapkan.</dd></div>
        <div><dt>SSP</dt><dd>Sumbangan Sarana Pendidikan. Nilai penuh mengikuti gelombang pendaftaran, terpisah dari biaya kuliah per semester.</dd></div>
      </dl>
      <dl class="tuition-component-summary" aria-label="Ringkasan empat komponen biaya S1">
        <div><dt>Pendaftaran</dt><dd>{formatRupiah(tuition.registration)}</dd></div>
        <div><dt>Prakuliah</dt><dd>{formatRupiah(tuition.preCollege)}</dd></div>
        <div><dt>Kuliah / semester</dt><dd>{formatRupiah(tuition.baseSemester)}–{formatRupiah(tuition.baseSemester + tuition.semesterSurcharge)}</dd></div>
        <div><dt>SSP</dt><dd>Sesuai gelombang</dd></div>
      </dl>
      <details class="tuition-definitions-mobile">
        <summary>Pelajari komponen biaya</summary>
        <dl class="tuition-definitions">
          <div><dt>Pendaftaran</dt><dd>{formatRupiah(tuition.registration)} untuk proses pendaftaran PMB.</dd></div>
          <div><dt>Prakuliah</dt><dd>Komponen biaya prakuliah S1 sebesar {formatRupiah(tuition.preCollege)}.</dd></div>
          <div><dt>Kuliah per semester</dt><dd>Tarif dasar {formatRupiah(tuition.baseSemester)}; tambahan {formatRupiah(tuition.semesterSurcharge)} hanya untuk enam program yang ditetapkan.</dd></div>
          <div><dt>SSP</dt><dd>Sumbangan Sarana Pendidikan. Nilai penuh mengikuti gelombang pendaftaran, terpisah dari biaya kuliah per semester.</dd></div>
        </dl>
      </details>
      <details class="tuition-rates">
        <summary>Lihat tarif kuliah seluruh program</summary>
        <dl>{tuitionRateGroups.map(([amount, programNames]) => <div><dt><strong>{programNames.length} program</strong><span>{programNames.join(', ')}</span></dt><dd>{formatRupiah(amount)} / semester</dd></div>)}</dl>
      </details>
      <p class="tuition-baseline tuition-baseline-desktop">Acuan biaya diverifikasi 15 September 2026 untuk periode ini. Simulasi belum memperhitungkan beasiswa atau promo. Konfirmasi ketentuan pembayaran melalui <a href={registration.url}>PMB resmi UBSI</a>.</p>
      <details class="tuition-reference-mobile"><summary>Acuan estimasi biaya</summary><p>Acuan biaya diverifikasi 15 September 2026 untuk periode ini. Simulasi belum memperhitungkan beasiswa atau promo. Konfirmasi ketentuan pembayaran melalui <a href={registration.url}>PMB resmi UBSI</a>.</p></details>
    </div>
  </section>
  <section class="page-section tuition-scholarships" id="beasiswa" aria-labelledby="scholarships-title">
    <div class="container">
      <header class="heading-overview">
      <p class="eyebrow">Dukungan untuk potensimu</p>
      <h2 id="scholarships-title">Kenali pilihan beasiswa.</h2>
      <p class="lead">Peluang bantuan dipertimbangkan terpisah dari estimasi biaya. Penerimaan dan manfaat mengikuti penilaian serta ketentuan resmi.</p>
      </header>
      <div class="tuition-scholarship-list">{scholarships.items.map((item, index) => <article>
        <span class="meta-label" aria-hidden="true">0{index + 1}</span><h3>{item.name}</h3><p>{item.description}</p>
        <a class="text-link" href={scholarships.informationUrl}>Cek ketentuan {item.name} <span aria-hidden="true">↗</span></a>
      </article>)}</div>
      <p class="tuition-baseline">Informasi program mengacu pada baseline 15 September 2026. Ketersediaan pengajuan, syarat, dan besaran bantuan perlu dikonfirmasi di PMB resmi.</p>
    </div>
  </section>
  <section class="page-section tuition-next journey-bridge" aria-labelledby="tuition-next-title">
    <div class="container">
      <p class="meta-label">Langkah berikutnya</p>
      <h2 id="tuition-next-title">Rencana biaya sudah lebih jelas?</h2>
      <p>Pahami alur PMB sebelum melanjutkan pendaftaran melalui kanal resmi UBSI.</p>
      <div class="actions"><a class="button button-secondary" href="/pmb" data-academic-handoff="/pmb">Lihat Panduan PMB <span aria-hidden="true">→</span></a><a class="text-link" href={registration.url}>{registration.label} <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  </div>
  <GraduateContent view="costs" />
  </div>
</BaseLayout>
