---
import DegreeSelector from '../components/DegreeSelector.astro';
import GraduateContent from '../components/GraduateContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgramRow from '../components/programs/ProgramRow.astro';
import { faculties, margondaPrograms } from '../data/programs';
import { campus } from '../data/campus';
import { registration } from '../data/admissions';
import '../styles/programs.css';
---
<BaseLayout title="Program Studi" description="Jelajahi program Sarjana dan Pascasarjana UBSI Margonda untuk September 2026. Kenali program, kelas, biaya, dan panduan pendaftaran.">
  <div class="academic-route">
  <DegreeSelector />
  <div data-degree-panel="S1" id="sarjana">
  <section class="page-section programs-intro">
    <div class="container">
      <p class="eyebrow">{campus.name} · {margondaPrograms.periodLabel}</p>
      <h1>Temukan program studi<br />yang sesuai minatmu.</h1>
      <p class="lead">Jelajahi {margondaPrograms.programs.length} pilihan program Sarjana ({margondaPrograms.degree}) di Margonda. Kenali bidangnya, bandingkan pilihan waktu kuliah, lalu siapkan langkah berikutnya.</p>
      <a class="text-link" href="#program-explorer">Jelajahi {margondaPrograms.programs.length} program <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section class="page-section programs-section" id="program-explorer" aria-labelledby="explorer-title">
    <div class="container" data-program-explorer>
      <div class="programs-heading heading-utility">
        <p class="eyebrow">Pilihan studi di Margonda</p>
        <h2 id="explorer-title">Mulai dari bidang yang kamu minati.</h2>
        <p>Semua program di bawah tersedia untuk {margondaPrograms.periodLabel}. Buka nama program untuk mengenali bidangnya dan melihat langkah berikutnya.</p>
      </div>
      <form class="program-controls" aria-label="Pencarian dan filter program studi" hidden>
        <div class="program-field">
          <label for="program-search">Cari program studi</label>
          <input id="program-search" type="search" placeholder="Contoh: Informatika" autocomplete="off" aria-controls="program-list" />
        </div>
        <div class="program-field">
          <label for="faculty-filter">Fakultas</label>
          <select id="faculty-filter" aria-controls="program-list">
            <option value="all">Semua fakultas</option>
            {Object.entries(faculties).map(([id, name]) => <option value={id}>{name}</option>)}
          </select>
        </div>
        <button class="program-reset" type="reset">Reset pencarian <span aria-hidden="true">↺</span></button>
      </form>
      <noscript><p>Semua program ditampilkan di bawah. Aktifkan JavaScript untuk menggunakan pencarian dan filter fakultas.</p></noscript>
      <div class="program-list-intro">
        <p class="program-results" role="status" aria-live="polite" aria-atomic="true" data-program-count>Menampilkan {margondaPrograms.programs.length} dari {margondaPrograms.programs.length} program.</p>
        <p class="program-list-hint">Kenali bidangnya, lalu rencanakan biayanya.</p>
      </div>
      <div class="program-list" id="program-list">
        {margondaPrograms.programs.map((program, index) => <ProgramRow program={program} index={index} />)}
      </div>
      <div class="program-empty" data-program-empty hidden>
        <h3>Program studi tidak ditemukan.</h3>
        <p>Coba nama program lain atau tampilkan kembali semua fakultas.</p>
        <button class="button button-secondary" type="button" data-program-reset>Tampilkan semua program</button>
      </div>
      <aside class="program-schedule-note" aria-labelledby="schedule-note-title">
        <h3 id="schedule-note-title">Tentang pilihan waktu kuliah</h3>
        <p>Pilihan kelas mengikuti {margondaPrograms.periodLabel} di Margonda. Waktu yang tersedia ditampilkan pada setiap program. {!margondaPrograms.fridaySaturdayAvailable && 'Kelas Jumat / Sabtu tidak dibuka untuk daftar S1 ini.'}</p>
      </aside>
    </div>
  </section>
  <section class="page-section program-next-section" aria-labelledby="program-next-title">
    <div class="container">
      <div class="program-next-heading heading-overview">
        <p class="eyebrow">Dari pilihan ke rencana</p>
        <h2 id="program-next-title">Jurusan sudah dipertimbangkan.<br /> Sekarang, rencanakan langkahmu.</h2>
        <p>Kenali pilihan studi, siapkan rencana biaya, lalu lanjutkan pendaftaran melalui PMB resmi UBSI.</p>
      </div>
      <ol class="program-journey" role="list" aria-label="Langkah menuju pendaftaran">
        <li class="program-journey-current" aria-current="step">
          <span class="program-step-number" aria-hidden="true">01</span>
          <div><p class="program-step-label">Anda di sini</p><h3>Pilih Program</h3><p>Kenali bidang dan pilihan waktu kuliah yang sesuai dengan rencanamu.</p></div>
        </li>
        <li class="program-journey-next">
          <span class="program-step-number" aria-hidden="true">02</span>
          <div><p class="program-step-label">Langkah berikutnya</p><h3>Hitung Biaya &amp;<br />Cek Beasiswa</h3>
            <p id="program-cost-note">Simulasikan biaya program pilihanmu dan kenali peluang beasiswa.</p>
            <a class="program-journey-link" href="/biaya-beasiswa">Lihat Biaya &amp; Beasiswa <span aria-hidden="true">→</span></a>
          </div>
        </li>
        <li>
          <span class="program-step-number" aria-hidden="true">03</span>
          <div><p class="program-step-label">Setelah siap</p><h3>Daftar melalui<br />PMB Resmi</h3><p>Lanjutkan pendaftaran melalui kanal resmi UBSI.</p>
            <a class="text-link" href={registration.url}>{registration.label} <span aria-hidden="true">↗</span></a>
          </div>
        </li>
      </ol>
    </div>
  </section>
  </div>
  <GraduateContent view="programs" />
  </div>
</BaseLayout>
<script>
  import '../scripts/program-explorer';
</script>
