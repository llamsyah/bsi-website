---
import { graduatePrograms, graduateIntake } from '../data/graduate';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdmissionsStatus from '../components/AdmissionsStatus.astro';
import { campus } from '../data/campus';
import { institution } from '../data/institution';
import { registration, september2026 as period } from '../data/admissions';
import { faculties, margondaPrograms } from '../data/programs';
import { margondaAPreview } from '../data/facilities';
import { homeEditorialContent } from '../data/homeEditorial';
import { formatCalendarDate, formatCalendarRange } from '../utils/calendarDate';
import '../styles/home.css';

const formatEditorialDate = (item: (typeof homeEditorialContent.supporting)[number]) => {
  if (!item.eventStart) return formatCalendarDate(item.publishDate);
  return item.eventEnd && item.eventEnd !== item.eventStart
    ? formatCalendarRange(item.eventStart, item.eventEnd)
    : formatCalendarDate(item.eventStart);
};

---
<BaseLayout title="Beranda" description="Kenali UBSI Kampus Margonda: pilihan program S1, jadwal PMB September 2026, kampus, dan panduan menuju pendaftaran resmi.">
  <section class="home-hero" aria-labelledby="page-title">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><span class="accent-dot" aria-hidden="true"></span>{margondaPrograms.periodLabel}</p>
        <h1 id="page-title">UBSI Kampus <span class="headline-accent">Margonda</span></h1>
        <p class="hero-identity">{institution.name} · {institution.branding}</p>
        <p class="hero-offering"><strong>{margondaPrograms.programs.length} Program S1</strong><span aria-hidden="true">·</span><strong>{graduatePrograms.length} Program Magister</strong></p>
        <p class="hero-subhead">Kenali pilihan studi, kampus, biaya, dan langkah PMB untuk menentukan rencana kuliahmu.</p>
        <p class="hero-trust"><span><strong>{institution.accreditation.label}</strong></span><span>{campus.buildings.length} Lokasi di Margonda</span></p>
      </div>
      <figure class="hero-campus">
        <div class="hero-campus-image">
          <img src={margondaAPreview.image.src} alt={margondaAPreview.image.alt} width={margondaAPreview.image.width} height={margondaAPreview.image.height} loading="eager" decoding="async" fetchpriority="high" />
        </div>
        <figcaption>Kampus Margonda A · Depok</figcaption>
      </figure>
      <div class="hero-transition">
        <div class="hero-transition-inner">
          <p>Jelajahi pilihan studi sebelum melanjutkan pendaftaran.</p>
          <div class="actions hero-transition-actions">
            <a class="button button-on-dark" href="/program-studi">Lihat Program Studi<span aria-hidden="true">→</span></a>
            <a class="text-link light-link" href={registration.url}>{registration.label}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section campus-discovery" aria-labelledby="campus-title">
    <div class="container campus-teaser">
      <figure class="campus-teaser-media">
        <img src={margondaAPreview.image.src} alt={margondaAPreview.image.alt} width={margondaAPreview.image.width} height={margondaAPreview.image.height} loading="lazy" decoding="async" />
        <figcaption>Kampus Margonda A · Depok</figcaption>
      </figure>
      <div class="campus-teaser-copy">
        <p class="eyebrow">Kampus Margonda</p>
        <h2 id="campus-title">Kenali tempat pilihanmu bertumbuh.</h2>
        <p>{campus.name} hadir melalui {campus.buildings.length} lokasi di Depok. Lihat identitas kampus, perbedaan lokasi, dan fasilitas yang sudah terdokumentasi pada halaman Kampus Margonda.</p>
        <a class="text-link" href="/kampus">Kenali Kampus Margonda <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-section program-section" id="pilihan-studi" aria-labelledby="program-title">
    <div class="container">
      <div class="section-heading section-heading-stacked program-intro heading-overview">
        <div>
          <p class="eyebrow">Program Studi</p>
          <h2 id="program-title">Temukan jenjang dan bidang yang sesuai.</h2>
        </div>
        <p class="section-description">Home memberi gambaran singkat. Pencarian, perbandingan, dan detail program tetap tersedia di halaman Program Studi.</p>
      </div>
      <div class="program-teaser">
        <div class="program-teaser-anchor">
          <p class="program-total"><strong>{margondaPrograms.programs.length}</strong><span>Program {margondaPrograms.degree}</span></p>
          <p class="program-period">{margondaPrograms.periodLabel} · Kampus Margonda</p>
        </div>
        <div class="program-teaser-samples">
          <p class="meta-label">Ruang studi yang tersedia</p>
          <ul class="program-sample-labels" role="list" aria-label={`${Object.keys(faculties).length} fakultas pada pilihan S1 Margonda`}>
            {Object.values(faculties).map(faculty => <li>{faculty}</li>)}
          </ul>
          <a class="button button-secondary program-teaser-cta" href="/program-studi?jenjang=s1">Jelajahi Program S1 <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="home-graduate-strip" aria-labelledby="home-graduate-title">
        <div class="home-graduate-copy">
          <p class="meta-label">Program Pascasarjana di Margonda</p>
          <h3 id="home-graduate-title">Lanjutkan studi ke jenjang Magister.</h3>
        </div>
        <ul class="home-graduate-programs" role="list">
          {graduatePrograms.map(program => <li>{program.name}</li>)}
        </ul>
        <div class="home-graduate-meta" aria-label="Jadwal Pascasarjana">
          <span><strong>Intake</strong>{graduateIntake.label}</span>
          <span><strong>Kelas</strong>{graduateIntake.classLabel}</span>
        </div>
        <a class="text-link home-graduate-link" href="/program-studi?jenjang=s2">Lihat Pascasarjana <span aria-hidden="true">→</span></a>
      </aside>
      <div class="cost-handoff" aria-labelledby="cost-title">
        <div>
          <p class="meta-label">Langkah setelah memilih program</p>
          <h3 id="cost-title">Sudah punya pilihan? Cek estimasi biayanya.</h3>
        </div>
        <p>Gunakan simulator untuk memahami komponen biaya S1, atau lihat pilihan pembayaran Pascasarjana.</p>
        <a class="text-link" href="/biaya-beasiswa">Hitung biaya kuliah <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-section home-editorial" aria-labelledby="activities-title">
    <div class="container">
      <header class="editorial-home-heading">
        <p class="eyebrow">Aktivitas &amp; agenda</p>
        <h2 id="activities-title">{homeEditorialContent.title}</h2>
        <p>Kegiatan terbaru dan momen terdekat yang membantu calon mahasiswa melihat kehidupan di UBSI Margonda.</p>
      </header>
      <div class="editorial-home-grid">
        <article class="editorial-home-feature">
          <div class:list={['editorial-placeholder', `editorial-placeholder--${homeEditorialContent.featured.visual.motif}`]} role="img" aria-label={homeEditorialContent.featured.visual.label}>
            <span>UBSI</span><strong>20·09</strong><small>Agenda mahasiswa baru 2026</small>
          </div>
          <div class="editorial-home-copy">
            <p class="editorial-meta">
              <span>{homeEditorialContent.featured.category}</span>
              <span data-editorial-temporal data-event-start={homeEditorialContent.featured.eventStart} data-event-end={homeEditorialContent.featured.eventEnd}>Agenda terjadwal</span>
              <time datetime={homeEditorialContent.featured.eventStart ?? homeEditorialContent.featured.publishDate}>{formatEditorialDate(homeEditorialContent.featured)}</time>
            </p>
            <h3>{homeEditorialContent.featured.title}</h3>
            <p>{homeEditorialContent.featured.summary}</p>
            <p class="editorial-scope">{homeEditorialContent.featured.scopeLabel}</p>
            <a class="text-link" href={homeEditorialContent.featured.sourceUrl} target="_blank" rel="noopener noreferrer">{homeEditorialContent.featured.sourceLabel} <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        <div class="editorial-home-supporting">
          {homeEditorialContent.supporting.map(item => (
            <article>
              <div class:list={['editorial-placeholder', 'editorial-placeholder--compact', `editorial-placeholder--${item.visual.motif}`]} role="img" aria-label={item.visual.label}><span aria-hidden="true">{item.id === 'ormik-margonda-2026' ? 'ORMIK' : 'DIGITAL'}</span></div>
              <div>
                <p class="editorial-meta"><span>{item.category}</span><span data-editorial-temporal data-event-start={item.eventStart} data-event-end={item.eventEnd}>Kegiatan terjadwal</span></p>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <p class="editorial-date"><time datetime={item.eventStart ?? item.publishDate}>{formatEditorialDate(item)}</time> · {item.scopeLabel}</p>
                <a class="text-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceLabel} <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="home-section home-pmb" aria-labelledby="home-pmb-title">
    <div class="container home-pmb-inner">
      <div>
        <p class="eyebrow">Penerimaan mahasiswa baru · Sarjana (S1)</p>
        <h2 id="home-pmb-title">{period.label}</h2>
        <AdmissionsStatus />
      </div>
      <div class="home-pmb-next">
        <span class="meta-label">Awal perkuliahan S1</span>
        <p><time datetime={period.classStart}>{formatCalendarDate(period.classStart)}</time></p>
        <a class="button button-primary" href={registration.url}>{registration.label} <span aria-hidden="true">↗</span></a>
        <a class="text-link light-link" href="/pmb">Lihat Panduan PMB S1 / S2 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>import '../scripts/editorial-status';</script>
