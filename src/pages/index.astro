---
import { graduatePrograms, graduateIntake } from '../data/graduate';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdmissionsStatus from '../components/AdmissionsStatus.astro';
import { campus } from '../data/campus';
import { institution } from '../data/institution';
import { registration, september2026 as period } from '../data/admissions';
import { faculties, margondaPrograms } from '../data/programs';
import { margondaAPreview } from '../data/facilities';
import { homeEditorialContent } from '../data/homeEditorial';
import { formatCalendarDate } from '../utils/calendarDate';
import '../styles/home.css';

---
<BaseLayout title="Beranda" description="Kenali UBSI Kampus Margonda: pilihan program S1, jadwal PMB September 2026, kampus, dan panduan menuju pendaftaran resmi.">
  <section class="home-hero" aria-labelledby="page-title">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><span class="accent-dot" aria-hidden="true"></span>{campus.name}</p>
        <h1 id="page-title"><span class="headline-line">Kuliah yang <span class="headline-accent">Relevan</span></span><span class="headline-line">untuk Masa Depan</span></h1>
        <p class="hero-subhead">Kenali pilihan studimu di {institution.branding}. Temukan program yang sesuai, pahami rencana biaya, dan siapkan langkah menuju perkuliahan.</p>
        <div class="actions hero-actions">
          <a class="button button-primary" href={registration.url}>{registration.label}<span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/program-studi">Lihat Program Studi<span aria-hidden="true">→</span></a>
        </div>
        <a class="hero-explore" href="#pilihan-studi"><span aria-hidden="true">↓</span> Kenali pilihanmu di Margonda</a>
      </div>
      <figure class="hero-campus">
        <div class="hero-campus-image">
          <img src={margondaAPreview.image.src} alt={margondaAPreview.image.alt} width={margondaAPreview.image.width} height={margondaAPreview.image.height} loading="eager" decoding="async" fetchpriority="high" />
          <span class="hero-photo-label">Foto resmi UBSI</span>
        </div>
        <figcaption>
          <span class="meta-label">Kampus Margonda A</span>
          <strong>{campus.buildings[0].address}</strong>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="trust-strip" aria-label="Informasi institusi dan pilihan studi Margonda">
    <div class="container trust-grid">
      <div><span class="trust-caption">Akreditasi institusi · {institution.accreditation.authority}</span><p class="trust-value accreditation">{institution.accreditation.label}</p><span class="trust-note">{institution.name}</span></div>
      <div><span class="trust-caption">Pilihan studi Margonda</span><p class="trust-value"><span class="mono">{margondaPrograms.programs.length}</span> Program {margondaPrograms.degree}</p><span class="trust-note">{margondaPrograms.periodLabel}</span></div>
      <div><span class="trust-caption">Identitas UBSI</span><p class="trust-value">{institution.branding}</p><span class="trust-note">Kenali kampus dan pilihan studimu</span></div>
    </div>
  </section>

  <section class="home-section campus-discovery" aria-labelledby="campus-title">
    <div class="container campus-teaser">
      <figure class="campus-teaser-media">
        <img src={margondaAPreview.image.src} alt={margondaAPreview.image.alt} width={margondaAPreview.image.width} height={margondaAPreview.image.height} loading="lazy" decoding="async" />
        <figcaption>Foto resmi UBSI · Margonda A</figcaption>
      </figure>
      <div class="campus-teaser-copy">
        <p class="eyebrow">Kampus Margonda</p>
        <h2 id="campus-title">Kenali tempat pilihanmu bertumbuh.</h2>
        <p>{campus.name} hadir melalui {campus.buildings.length} lokasi di Depok. Lihat identitas kampus, perbedaan lokasi, dan fasilitas yang sudah terdokumentasi pada halaman Kampus Margonda.</p>
        <a class="button button-secondary" href="/kampus">Kenali Kampus Margonda <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-section program-section" id="pilihan-studi" aria-labelledby="program-title">
    <div class="container">
      <div class="section-heading section-heading-stacked program-intro">
        <div>
          <p class="eyebrow">Program Studi</p>
          <h2 id="program-title">Temukan jenjang dan bidang yang sesuai.</h2>
        </div>
        <p class="section-description">Home memberi gambaran singkat. Pencarian, perbandingan, dan detail program tetap tersedia di halaman Program Studi.</p>
      </div>
      <div class="program-teaser">
        <div class="program-teaser-anchor">
          <p class="program-total"><strong>{margondaPrograms.programs.length}</strong><span>Program {margondaPrograms.degree}</span></p>
          <p class="program-period">{margondaPrograms.periodLabel} · Kampus Margonda</p>
          <a class="button button-primary" href="/program-studi?jenjang=s1">Jelajahi Program S1 <span aria-hidden="true">→</span></a>
        </div>
        <div class="program-teaser-samples">
          <p class="meta-label">Ruang studi yang tersedia</p>
          <ul class="program-sample-labels" role="list" aria-label={`${Object.keys(faculties).length} fakultas pada pilihan S1 Margonda`}>
            {Object.values(faculties).map(faculty => <li>{faculty}</li>)}
          </ul>
        </div>
      </div>
      <aside class="home-graduate-strip" aria-labelledby="home-graduate-title">
        <div class="home-graduate-copy">
          <p class="meta-label">Program Pascasarjana di Margonda</p>
          <h3 id="home-graduate-title">Lanjutkan studi ke jenjang Magister.</h3>
        </div>
        <ul class="home-graduate-programs" role="list">
          {graduatePrograms.map(program => <li>{program.name}</li>)}
        </ul>
        <div class="home-graduate-meta" aria-label="Jadwal Pascasarjana">
          <span><strong>Intake</strong>{graduateIntake.label}</span>
          <span><strong>Kelas</strong>{graduateIntake.classLabel}</span>
        </div>
        <a class="text-link home-graduate-link" href="/program-studi?jenjang=s2">Lihat Pascasarjana <span aria-hidden="true">→</span></a>
      </aside>
      <div class="cost-handoff" aria-labelledby="cost-title">
        <div>
          <p class="meta-label">Langkah setelah memilih program</p>
          <h3 id="cost-title">Sudah punya pilihan? Cek estimasi biayanya.</h3>
        </div>
        <p>Gunakan simulator untuk memahami komponen biaya S1, atau lihat pilihan pembayaran Pascasarjana.</p>
        <a class="button button-secondary" href="/biaya-beasiswa">Hitung biaya kuliah <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  {homeEditorialContent.studentLife.items.length > 0 && (
    <section class="home-section home-editorial" aria-labelledby="student-life-title">
      <div class="container">
        <div class="section-heading section-heading-stacked">
          <div><p class="eyebrow">Student Life</p><h2 id="student-life-title">{homeEditorialContent.studentLife.title}</h2></div>
        </div>
        <div class="editorial-highlights">
          {homeEditorialContent.studentLife.items.slice(0, 3).map(item => (
            <article>
              <img src={item.image.src} alt={item.image.alt} loading="lazy" decoding="async" />
              <p class="meta-label">{item.category}</p><h3>{item.title}</h3><p>{item.summary}</p>
              <a class="text-link" href={item.sourceUrl}>Baca sumber <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {homeEditorialContent.activities.items.length > 0 && (
    <section class="home-section home-editorial soft-surface" aria-labelledby="activities-title">
      <div class="container">
        <div class="section-heading section-heading-stacked">
          <div><p class="eyebrow">Aktivitas terkini</p><h2 id="activities-title">{homeEditorialContent.activities.title}</h2></div>
        </div>
        <div class="editorial-highlights">
          {homeEditorialContent.activities.items.slice(0, 3).map(item => (
            <article>
              <img src={item.image.src} alt={item.image.alt} loading="lazy" decoding="async" />
              <p class="meta-label">{item.category}</p><h3>{item.title}</h3><p>{item.summary}</p>
              <a class="text-link" href={item.sourceUrl}>Baca sumber <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="home-section home-pmb" aria-labelledby="home-pmb-title">
    <div class="container home-pmb-inner">
      <div>
        <p class="eyebrow">Penerimaan mahasiswa baru</p>
        <h2 id="home-pmb-title">{period.label}</h2>
        <AdmissionsStatus />
      </div>
      <div class="home-pmb-next">
        <span class="meta-label">Awal perkuliahan S1</span>
        <p><time datetime={period.classStart}>{formatCalendarDate(period.classStart)}</time></p>
        <a class="button button-white" href="/pmb">Lihat Panduan PMB <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-section final-section" aria-labelledby="final-title">
    <div class="container final-cta">
      <div><p class="eyebrow">Langkah berikutnya</p><h2 id="final-title">Siap melanjutkan?</h2><p>Pendaftaran berlangsung melalui sistem PMB resmi UBSI.</p></div>
      <div class="final-actions"><a class="button button-primary" href={registration.url}>{registration.label}<span aria-hidden="true">↗</span></a><a class="text-link light-link" href="/pmb">Lihat Panduan PMB <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
</BaseLayout>
