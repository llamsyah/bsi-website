---
import { graduatePrograms, graduateIntake } from '../data/graduate';
import BaseLayout from '../layouts/BaseLayout.astro';
import { registration } from '../data/admissions';
import { campus } from '../data/campus';
import { contact } from '../data/contact';
import { margondaAFacilities } from '../data/facilities';
import { institution } from '../data/institution';
import { classTimes, faculties, margondaPrograms } from '../data/programs';
import { campusExperienceContent } from '../data/homeEditorial';
import { formatCalendarRange } from '../utils/calendarDate';
import '../styles/campus.css';

const [margondaA, margondaB] = campus.buildings;
const facultyCount = Object.keys(faculties).length;
const eveningPrograms = margondaPrograms.programs.filter(program => program.classes.includes('sore-malam'));
const accreditationNumber = institution.accreditation.reference.replace('SK BAN-PT No. ', '');
const fair = campusExperienceContent.studentLife.featured;
const fairDate = fair.eventStart && fair.eventEnd ? formatCalendarRange(fair.eventStart, fair.eventEnd) : '';
---
<BaseLayout title="Kampus Margonda" description="Kenali UBSI, dua lokasi Kampus Margonda, bidang studi, pilihan kelas, fasilitas Margonda A, alamat, dan kontak PMB.">
  <section class="campus-hero" aria-labelledby="page-title">
    <div class="campus-hero-media" aria-hidden="true">
      <img src="/images/facilities/parkiran-gedung.jpg" alt="" width="1600" height="1067" fetchpriority="high" />
    </div>
    <div class="campus-hero-shade"></div>
    <div class="container campus-hero-inner">
      <div class="campus-hero-copy">
        <p class="eyebrow">{institution.branding} · Depok</p>
        <h1 id="page-title">UBSI Kampus Margonda</h1>
        <p>{institution.name} di Margonda hadir melalui dua lokasi, dengan {margondaPrograms.programs.length} program S1 dan {graduatePrograms.length} program Magister.</p>
        <div class="campus-hero-actions">
          <a class="text-link light-link" href="#dua-lokasi">Kenali dua lokasi <span aria-hidden="true">↓</span></a>
          <a class="button button-on-dark" href="/program-studi">Lihat Program Studi <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="campus-hero-profile" aria-label="Ringkasan UBSI Kampus Margonda">
        <div class="campus-accreditation">
          <span>Akreditasi institusi</span>
          <strong>Unggul</strong>
          <p>{institution.accreditation.authority} SK No. {accreditationNumber}</p>
        </div>
        <dl class="campus-hero-facts">
          <div><dt>Lokasi</dt><dd>{campus.buildings.length}</dd><span>Margonda A &amp; B</span></div>
          <div><dt>Program</dt><dd>{margondaPrograms.programs.length}</dd><span>Program S1</span></div>
          <div><dt>Pascasarjana</dt><dd>{graduatePrograms.length}</dd><span>Program Magister</span></div>
        </dl>
        <p class="campus-photo-credit"><span>Foto resmi</span> Kampus Margonda A</p>
      </aside>
    </div>
  </section>

  <section class="campus-section campus-buildings" id="dua-lokasi" aria-labelledby="buildings-title">
    <div class="container">
      <header class="campus-section-heading">
        <div>
          <p class="meta-label">Dua lokasi Margonda</p>
          <h2 id="buildings-title">Alamat yang jelas, informasi yang terukur.</h2>
          <p>Kenali alamat masing-masing lokasi sebelum berkunjung atau membuka petanya.</p>
        </div>
      </header>

      <div class="campus-building-pair">
        <article class="campus-building campus-building-a">
          <figure>
            <img src="/images/margonda-a.png" alt="Gedung UBSI Kampus Margonda A dari situs resmi UBSI" width="263" height="293" loading="lazy" decoding="async" />
            <figcaption>Visual resmi UBSI</figcaption>
          </figure>
          <div class="campus-building-copy">
            <p class="campus-building-label">Lokasi 01 · Margonda</p>
            <h3>{margondaA.name}</h3>
            <address>{margondaA.address}</address>
            <p>Jelajahi fasilitas Margonda A pada bagian berikutnya.</p>
            <a class="text-link" href={margondaA.mapsUrl}>Lihat lokasi di peta <span aria-hidden="true">↗</span></a>
          </div>
        </article>

        <article class="campus-building campus-building-b">
          <div class="campus-b-slot" role="img" aria-label="Identitas visual Kampus Margonda B">
            <span class="campus-b-mark" aria-hidden="true">B</span>
            <div>
              <span class="meta-label">UBSI Kampus Margonda</span>
              <strong>Margonda B</strong>
            </div>
          </div>
          <div class="campus-building-copy">
            <p class="campus-building-label">Lokasi 02 · Margonda</p>
            <h3>{margondaB.name}</h3>
            <address>{margondaB.address}</address>
            <p>Buka peta untuk melihat posisi lokasi ini sebelum berkunjung.</p>
            <a class="text-link" href={margondaB.mapsUrl}>Lihat lokasi di peta <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="campus-section campus-academic" aria-labelledby="academic-title">
    <div class="container campus-academic-overview">
      <header class="heading-overview">
        <p class="meta-label">Pilihan akademik Margonda</p>
        <h2 id="academic-title">Dari Sarjana hingga Pascasarjana.</h2>
        <p>Temukan jenjang yang sesuai dengan rencana studimu.</p>
      </header>
      <div class="academic-pathways">
        <div><p class="academic-pathway-total"><strong>{margondaPrograms.programs.length}</strong> Program S1</p><p>{facultyCount} fakultas · {margondaPrograms.periodLabel}</p></div>
        <div><p class="academic-pathway-total"><strong>{graduatePrograms.length}</strong> Program Magister</p><p>{graduateIntake.classLabel} · {graduateIntake.label}</p><p class="academic-pathway-names">{graduatePrograms.map(program => program.name).join(' · ')}</p></div>
      </div>
      <a class="text-link" href="/program-studi">Jelajahi Program Studi <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="campus-section campus-classes" aria-labelledby="classes-title">
    <div class="container">
      <header class="campus-section-heading campus-section-heading--classes">
        <div>
          <p class="meta-label">Pilihan waktu kuliah</p>
          <h2 id="classes-title">Pilih kelas sesuai program yang tersedia.</h2>
          <p>Pilihan waktu Sarjana (S1) mengikuti program pada periode PMB Margonda saat ini.</p>
        </div>
      </header>

      <div class="class-option-grid">
        <article>
          <span class="class-option-count">Semua {margondaPrograms.programs.length} program</span>
          <h3>{classTimes['pagi-siang']}</h3>
          <p>Tersedia untuk seluruh program S1 Margonda.</p>
        </article>
        <article>
          <span class="class-option-count">{eveningPrograms.length} program</span>
          <h3>{classTimes['sore-malam']}</h3>
          <p>{eveningPrograms.map(program => program.name).join(' · ')}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="campus-section campus-facilities" aria-labelledby="facilities-title">
    <div class="container">
      <header class="campus-section-heading campus-section-heading--facilities">
        <div>
          <p class="meta-label">Fasilitas Margonda A</p>
          <h2 id="facilities-title">Ruang yang tersedia di Margonda A.</h2>
          <p>Jelajahi ruang belajar dan fasilitas pendukung yang tersedia di lokasi Margonda A.</p>
        </div>
      </header>

      <div class="facility-gallery">
        {margondaAFacilities.map((facility, index) => (
          <figure class:list={['facility-item', index === 1 && 'facility-item--wide', index === 7 && 'facility-item--panorama']}>
            <img src={facility.image} alt={`${facility.name} di Kampus Margonda A`} width={index === 7 ? 1600 : 600} height={index === 7 ? 1067 : 600} loading="lazy" decoding="async" />
            <figcaption><span>{String(index + 1).padStart(2, '0')}</span>{facility.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="campus-experience" aria-labelledby="experience-title">
    <div class="container">
      <header class="campus-experience-heading">
        <p class="meta-label">Campus Experience</p>
        <h2 id="experience-title">Lebih dari ruang kelas dan fasilitas.</h2>
        <p>Kenali pengalaman, karya, kesempatan, dan perjalanan orang-orang yang tumbuh bersama UBSI Kampus Margonda.</p>
      </header>

      <section class="experience-group" aria-labelledby="student-life-title">
        <header class="experience-subheading">
          <span>01</span><div><p class="meta-label">Student Life</p><h3 id="student-life-title">Belajar melalui pengalaman nyata.</h3></div>
        </header>
        <article class="experience-feature experience-feature--student">
          <div class:list={['experience-placeholder', `experience-placeholder--${fair.visual.motif}`]} role="img" aria-label={fair.visual.label}>
            <span>UBSI Margonda</span><strong>IDE<br />JADI<br />AKSI</strong><small>Student Life · 2026</small>
          </div>
          <div class="experience-feature-copy">
            <p class="experience-meta"><span>{fair.category}</span><time datetime={fair.eventStart}>{fairDate}</time></p>
            <h4>{fair.title}</h4>
            <p>{fair.summary}</p>
            <p class="experience-scope">{fair.scopeLabel}</p>
            <a class="text-link" href={fair.sourceUrl} target="_blank" rel="noopener noreferrer">{fair.sourceLabel} <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        <div class="experience-supporting">
          {campusExperienceContent.studentLife.supporting.map((item, index) => (
            <article>
              <span class="experience-index">0{index + 2}</span>
              <div><p class="meta-label">{item.category}</p><h4>{item.title}</h4><p>{item.summary}</p><a class="text-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceLabel} <span aria-hidden="true">↗</span></a></div>
            </article>
          ))}
        </div>
      </section>

      <section class="experience-group experience-group--people" aria-labelledby="stories-title">
        <header class="experience-subheading">
          <span>02</span><div><p class="meta-label">Stories &amp; Achievements</p><h3 id="stories-title">Cerita manusia di balik perjalanan kampus.</h3></div>
        </header>
        <div class="people-composition">
          <article class="experience-feature experience-feature--people">
            <div class:list={['experience-placeholder', `experience-placeholder--${campusExperienceContent.stories.featured.visual.motif}`]} role="img" aria-label={campusExperienceContent.stories.featured.visual.label}>
              <span>Alumni · 2025</span><strong>INAS<br />ZHAFIRAH</strong><small>Ilmu Komunikasi Margonda</small>
            </div>
            <div class="experience-feature-copy">
              <p class="experience-meta"><span>{campusExperienceContent.stories.featured.category}</span><span>{campusExperienceContent.stories.featured.scopeLabel}</span></p>
              <h4>{campusExperienceContent.stories.featured.title}</h4>
              <p>{campusExperienceContent.stories.featured.summary}</p>
              <a class="text-link" href={campusExperienceContent.stories.featured.sourceUrl} target="_blank" rel="noopener noreferrer">{campusExperienceContent.stories.featured.sourceLabel} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
          <div class="people-supporting">
            {campusExperienceContent.stories.supporting.map(item => (
              <article>
                <p class="meta-label">{item.category}</p><h4>{item.title}</h4><p>{item.summary}</p>
                <a class="text-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceLabel} <span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
        </div>
      </section>
    </div>
  </section>

  <section class="campus-next journey-bridge" aria-labelledby="next-title">
    <div class="container campus-next-inner">
      <div>
        <p class="meta-label">Lanjutkan perjalananmu</p>
        <h2 id="next-title">Sudah mengenal kampusnya? Temukan program yang sesuai.</h2>
        <p>Jelajahi {margondaPrograms.programs.length} program S1 dan {graduatePrograms.length} program Magister di UBSI Kampus Margonda.</p>
      </div>
      <div class="campus-next-actions">
        <a class="button button-white" href="/program-studi">Lihat Program Studi <span aria-hidden="true">→</span></a>
        <div class="campus-secondary-actions">
          <a class="campus-register-link" href={contact.whatsapp.url}>WhatsApp PMB <span aria-hidden="true">↗</span></a>
          <a class="campus-register-link" href={registration.url}>Daftar Sekarang <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
